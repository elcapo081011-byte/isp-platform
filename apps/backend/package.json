{
  "name": "@isp/backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "dev": "nest start --watch",
    "migration:deploy": "prisma migrate deploy --schema=../../packages/database/prisma/schema.prisma",
    "db:push": "prisma db push --skip-generate --schema=../../packages/database/prisma/schema.prisma",
    "migration:dev": "prisma migrate dev --schema=../../packages/database/prisma/schema.prisma",
    "seed": "TS_NODE_COMPILER_OPTIONS='{\"module\":\"commonjs\"}' ts-node ../../packages/database/prisma/seed.ts",
    "test": "jest"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.0",
    "@nestjs/core": "^10.4.0",
    "@nestjs/platform-express": "^10.4.0",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/websockets": "^10.4.0",
    "@nestjs/platform-socket.io": "^10.4.0",
    "@nestjs/throttler": "^6.2.1",
    "@nestjs/swagger": "^7.4.0",
    "@nestjs/schedule": "^4.1.1",
    "@prisma/client": "^5.19.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "bcrypt": "^5.1.1",
    "class-validator": "^0.14.1",
    "class-transformer": "^0.5.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "helmet": "^8.3.0",
    "node-routeros-v2": "^1.6.12",
    "net-snmp": "^3.29.1",
    "nodemailer": "^10.0.10",
    "pdfkit": "^0.15.0",
    "socket.io": "^4.7.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.5",
    "@types/bcrypt": "^5.0.2",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/pdfkit": "^0.13.4",
    "@types/nodemailer": "^6.4.15",
    "prisma": "^5.19.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.4",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "@types/jest": "^29.5.13"
  }
}