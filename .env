# --- Base de datos ---
POSTGRES_USER=isp
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=isp_platform
DATABASE_URL=postgresql://isp:change_me_strong_password@postgres:5432/isp_platform?schema=public

# --- Redis ---
REDIS_URL=redis://redis:6379

# --- Backend / Auth ---
PORT=3000
JWT_SECRET=change_me_to_a_long_random_string
NODE_ENV=production

# --- Encriptación de credenciales de dispositivos (MikroTik/OLT) ---
# Nunca se guardan contraseñas de red en texto plano (punto 28).
DEVICE_CREDENTIALS_ENCRYPTION_KEY=change_me_32_byte_key_min

# --- Dueño de la plataforma (isPlatformAdmin) ---
# El seed usa ESTOS valores para crear tu usuario real de dueño.
# No dejes el ejemplo: pon tu propio email y una contraseña fuerte real.
# Si faltan, el seed falla en vez de crear un usuario genérico.
PLATFORM_OWNER_EMAIL=lssolutionsrd@gmail.com
PLATFORM_OWNER_PASSWORD=Luisanny.081011
PLATFORM_OWNER_FIRST_NAME=
PLATFORM_OWNER_LAST_NAME=

# --- Frontend ---
VITE_API_URL=http://localhost:8080/api/v1

# --- Notificaciones (Fase 9) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@tuisp.com
WHATSAPP_PROVIDER_API_KEY=

# --- Backups (Fase 10) ---
BACKUP_DIR=/app/backups
BACKUP_RETENTION_DAYS=14
